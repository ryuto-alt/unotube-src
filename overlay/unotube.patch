+++ b/extensions/youtube/src/main/java/app/morphe/extension/youtube/patches/theme/UnoTubeSplash.java
@@ -0,0 +1,280 @@
+package app.morphe.extension.youtube.patches.theme;
+
+import android.animation.ValueAnimator;
+import android.app.Activity;
+import android.content.Context;
+import android.content.ContextWrapper;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.animation.LinearInterpolator;
+
+import java.util.Random;
+
+import app.morphe.extension.shared.Logger;
+import app.morphe.extension.shared.theme.ThemeUtils;
+
+/**
+ * UnoTube の起動アニメーション。
+ * <p>
+ * YouTube は読み込みが終わった瞬間に起動画面(Lottie)を消すので、Lottie では最後まで見せられない。
+ * そこで起動時に画面のいちばん上へこの View をかぶせ、最後まで再生してから自分でフェードして消える。
+ * YouTube 側の処理には触らない。1 プロセスにつき 1 回(コールドスタート)だけ。
+ * <p>
+ * 座標は 432x432 の枠(アイコン前景 108dp の 4 倍)で考え、起動画面の Lottie ビューの位置・大きさに合わせて
+ * 拡大する。最初のコマは起動画面の静止アイコンと同じ見た目なので、途切れずにつながる。
+ */
+@SuppressWarnings("unused")
+public final class UnoTubeSplash extends View {
+
+    private static boolean played;
+
+    /** 60fps 換算のコマ数。 */
+    private static final float END = 56;
+    private static final float FADE_START = 44;
+    private static final long DURATION_MS = (long) (END / 60f * 1000);
+
+    private static final float W = 432;
+    private static final float R = W * 0.235f;
+    private static final float CX = W / 2 + R * 0.08f;
+    private static final float CY = W / 2;
+    private static final float GROUND = R * 0.5f;
+
+    private static final int MAUVE = 0xFFCBA6F7;
+    private static final int PINK = 0xFFF5C2E7;
+    private static final int[] CONFETTI = {
+            0xFFF5E0DC, 0xFFF38BA8, 0xFFFAB387, 0xFFF9E2AF, 0xFFA6E3A1, 0xFF94E2D5, 0xFF89DCEB,
+            0xFF74C7EC, 0xFF89B4FA, 0xFFB4BEFE, 0xFFF5C2E7, 0xFFCBA6F7, 0xFFF38BA8, 0xFFA6E3A1,
+    };
+
+    private final View lottie;
+    private final int background;
+    private final Path triangle = roundedTriangle(R, R * 0.2f);
+    private final Path smallTriangle = roundedTriangle(14, 3);
+    private final Paint trianglePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Particle[] particles = new Particle[14];
+    private final RectF rect = new RectF();
+    private final int[] lottieLocation = new int[2];
+    private final int[] selfLocation = new int[2];
+    private float frame;
+
+    private static final class Particle {
+        float angle, dist, fall, size, spin;
+        int t0, color, kind;
+    }
+
+    /**
+     * Injection point. YouTube が起動画面の Lottie をセットしたとき(Activity の onCreate)に呼ぶ。
+     */
+    public static void show(Object lottieView) {
+        try {
+            if (played || !(lottieView instanceof View view)) return;
+            Activity activity = findActivity(view.getContext());
+            if (activity == null) return;
+            played = true;
+
+            ViewGroup decor = (ViewGroup) activity.getWindow().getDecorView();
+            UnoTubeSplash splash = new UnoTubeSplash(activity, view);
+            decor.addView(splash, new ViewGroup.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+            splash.start();
+        } catch (Exception ex) {
+            Logger.printException(() -> "UnoTubeSplash failure", ex);
+        }
+    }
+
+    private static Activity findActivity(Context context) {
+        while (context instanceof ContextWrapper) {
+            if (context instanceof Activity activity) return activity;
+            context = ((ContextWrapper) context).getBaseContext();
+        }
+        return null;
+    }
+
+    private UnoTubeSplash(Context context, View lottie) {
+        super(context);
+        this.lottie = lottie;
+        int bg;
+        try {
+            bg = ThemeUtils.getAppBackgroundColor();
+        } catch (Exception ex) {
+            bg = 0xFF181825;
+        }
+        background = bg | 0xFF000000;
+
+        trianglePaint.setShader(new LinearGradient(-R * 0.5f, -R * 0.9f, R, R * 0.9f,
+                MAUVE, PINK, Shader.TileMode.CLAMP));
+
+        Random rng = new Random(11); // 毎回同じ散り方
+        for (int i = 0; i < particles.length; i++) {
+            Particle p = new Particle();
+            p.angle = (float) (-Math.PI / 2 + i * 2 * Math.PI / particles.length + (rng.nextFloat() - 0.5f) * 0.4f);
+            p.dist = R * (1.25f + rng.nextFloat() * 0.5f);
+            p.fall = 25 + rng.nextFloat() * 20;
+            p.size = 0.8f + rng.nextFloat() * 0.4f;
+            p.spin = (rng.nextBoolean() ? 1 : -1) * (180 + rng.nextInt(360));
+            p.t0 = 9 + rng.nextInt(4);
+            p.color = CONFETTI[i % CONFETTI.length];
+            p.kind = i % 3;
+            particles[i] = p;
+        }
+    }
+
+    private void start() {
+        ValueAnimator animator = ValueAnimator.ofFloat(0, END);
+        animator.setDuration(DURATION_MS);
+        animator.setInterpolator(new LinearInterpolator());
+        animator.addUpdateListener(a -> {
+            frame = (float) a.getAnimatedValue();
+            setAlpha(frame < FADE_START ? 1 : 1 - easeOut((frame - FADE_START) / (END - FADE_START)));
+            invalidate();
+        });
+        animator.addListener(new android.animation.AnimatorListenerAdapter() {
+            @Override
+            public void onAnimationEnd(android.animation.Animator animation) {
+                if (getParent() instanceof ViewGroup parent) parent.removeView(UnoTubeSplash.this);
+            }
+        });
+        animator.start();
+    }
+
+    // ── 補間 ──────────────────────────────────────────────
+    private static float easeOut(float t) { float u = 1 - t; return 1 - u * u * u; }
+    private static float easeIn(float t) { return t * t * t; }
+    private static float easeInOut(float t) { return t < 0.5f ? 4 * t * t * t : 1 - (float) Math.pow(-2 * t + 2, 3) / 2; }
+    private static float clamp01(float t) { return Math.max(0, Math.min(1, t)); }
+
+    /** keys = {frame, value, frame, value, ...}。区間ごとに easeInOut。 */
+    private static float track(float f, float... keys) {
+        if (f <= keys[0]) return keys[1];
+        for (int i = 2; i < keys.length; i += 2) {
+            if (f <= keys[i]) {
+                float t = (f - keys[i - 2]) / (keys[i] - keys[i - 2]);
+                return keys[i - 1] + (keys[i + 1] - keys[i - 1]) * easeInOut(t);
+            }
+        }
+        return keys[keys.length - 1];
+    }
+
+    private static Path roundedTriangle(float r, float corner) {
+        Path path = new Path();
+        float inset = corner / (float) Math.sin(Math.PI / 6);
+        boolean first = true;
+        for (int v = 0; v < 3; v++) {
+            double a = v * 2 * Math.PI / 3;
+            float vx = (float) (r * Math.cos(a)), vy = (float) (r * Math.sin(a));
+            float d = (float) Math.hypot(vx, vy);
+            float ox = vx - vx / d * inset, oy = vy - vy / d * inset;
+            for (int s = 0; s <= 8; s++) {
+                double b = a - Math.PI / 3 + (2 * Math.PI / 3) * s / 8;
+                float x = ox + corner * (float) Math.cos(b), y = oy + corner * (float) Math.sin(b);
+                if (first) { path.moveTo(x, y); first = false; } else path.lineTo(x, y);
+            }
+        }
+        path.close();
+        return path;
+    }
+
+    // ── 描画 ──────────────────────────────────────────────
+    @Override
+    protected void onDraw(Canvas canvas) {
+        canvas.drawColor(background);
+
+        // 起動画面の Lottie ビューと同じ場所・大きさに 432 の枠を合わせる(まだ無ければ画面中央 240dp)
+        float density = getResources().getDisplayMetrics().density;
+        float size, left, top;
+        if (lottie.getWidth() > 0 && lottie.isShown()) {
+            lottie.getLocationOnScreen(lottieLocation);
+            getLocationOnScreen(selfLocation);
+            size = Math.min(lottie.getWidth(), lottie.getHeight());
+            left = lottieLocation[0] - selfLocation[0] + (lottie.getWidth() - size) / 2f;
+            top = lottieLocation[1] - selfLocation[1] + (lottie.getHeight() - size) / 2f;
+        } else {
+            size = 240 * density;
+            left = (getWidth() - size) / 2f;
+            top = (getHeight() - size) / 2f;
+        }
+        canvas.save();
+        canvas.translate(left, top);
+        canvas.scale(size / W, size / W);
+
+        final float f = frame;
+        drawRipple(canvas, f);
+        for (Particle p : particles) drawParticle(canvas, p, f);
+        drawPlay(canvas, f);
+
+        canvas.restore();
+    }
+
+    private void drawPlay(Canvas canvas, float f) {
+        // 跳ねる高さ: ため(0-7) → 頂点(19) → 着地(28)
+        float y;
+        if (f < 7) y = 0;
+        else if (f < 19) y = -120 * easeOut((f - 7) / 12);
+        else if (f < 28) y = -120 * (1 - easeIn((f - 19) / 9));
+        else y = 0;
+
+        float sx = track(f, 0, 1, 7, 1.18f, 11, 0.86f, 19, 1, 26, 0.94f, 30, 1.26f, 35, 0.92f, 40, 1.04f, 44, 1);
+        float sy = track(f, 0, 1, 7, 0.78f, 11, 1.18f, 19, 1, 26, 1.08f, 30, 0.72f, 35, 1.10f, 40, 0.96f, 44, 1);
+        float rot = f < 8 ? 0 : f < 27 ? 360 * easeInOut((f - 8) / 19) : 360;
+        // 最後はアプリへ吸い込まれるように少し大きくなりながら消える
+        float zoom = f < FADE_START ? 1 : 1 + 0.25f * easeIn((f - FADE_START) / (END - FADE_START));
+
+        canvas.save();
+        canvas.translate(CX, CY + GROUND + y);   // 支点は三角形の下寄り(潰れ・伸びの中心)
+        canvas.scale(sx * zoom, sy * zoom);
+        canvas.translate(0, -GROUND);             // 回転は三角形の中心まわり
+        canvas.rotate(rot);
+        canvas.drawPath(triangle, trianglePaint);
+        canvas.restore();
+    }
+
+    private void drawParticle(Canvas canvas, Particle p, float f) {
+        int t1 = p.t0 + 15, t2 = t1 + 13;
+        if (f < p.t0 || f > t2) return;
+        float sx = CX, sy = CY - 40;
+        float mx = sx + (float) Math.cos(p.angle) * p.dist, my = sy + (float) Math.sin(p.angle) * p.dist;
+        float x, y;
+        if (f < t1) {
+            float t = easeOut((f - p.t0) / (t1 - p.t0));
+            x = sx + (mx - sx) * t;
+            y = sy + (my - sy) * t;
+        } else {
+            x = mx;
+            y = my + p.fall * easeIn((f - t1) / (t2 - t1));
+        }
+        float s = p.size * (f < p.t0 + 5 ? easeOut((f - p.t0) / 5) : f < t1 ? 1 : 1 - clamp01((f - t1) / (t2 - t1)));
+        float r = p.spin * clamp01((f - p.t0) / (t2 - p.t0));
+
+        canvas.save();
+        canvas.translate(x, y);
+        canvas.rotate(r);
+        canvas.scale(s, s);
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(p.color);
+        switch (p.kind) {
+            case 0 -> canvas.drawCircle(0, 0, 10, paint);
+            case 1 -> { rect.set(-13, -6, 13, 6); canvas.drawRoundRect(rect, 6, 6, paint); }
+            default -> canvas.drawPath(smallTriangle, paint);
+        }
+        canvas.restore();
+    }
+
+    private void drawRipple(Canvas canvas, float f) {
+        if (f < 29 || f > 50) return;
+        float t = easeOut((f - 29) / 21);
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setColor(MAUVE);
+        paint.setAlpha((int) (180 * (1 - t)));
+        paint.setStrokeWidth(9 - 8 * t);
+        canvas.drawCircle(CX, CY, R * (1.15f + 0.8f * t), paint);
+        paint.setAlpha(255);
+    }
+}
